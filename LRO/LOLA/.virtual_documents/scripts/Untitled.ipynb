import rasterio 
from pathlib import Path
import matplotlib.pyplot as plt 

# ====================================
# DATA DIRECTORY PATH 
# ====================================

# Project directory 
lola_root = Path(__file__).resolve().parent.parent

# Data directory & folder 
data_path = lola_root / 'data' / 'gdr_cylindrical'
data_path.mkdir(parents=True, exist_ok=True)

# ==============================================================
# Find all detached label files associated with the .img files 
# ==============================================================

lbl_files = sorted(list(data_path.glob('*.lbl')))

# ------------------
# Error Handling 
# ------------------

if not lbl_files:
    print('No .lbl files found in the data directory')

else: 
    print(f'Found {len(lbl_files)} label files in the directory')
    num_to_plot = int(input('Enter how many files you want to plot: '))

    for lbl_path in lbl_files[:num_to_plot]:
        print(f'Plotting: {label_path.name}')
        with rasterio.open(label_path) as src:
            elevation = src.read(1)

        plt.figure(figsize=(10,6))
        plt.imshow(elevation, cmap='gray', origin='upper')
        plt.colorbar(label='Elevation (m)')
        plt.title(f'LOLA Topography - {label_path.stem}')
        plt.xlabel('X Pixel')
        plt.ylabel('Y Pixel') 
        plt.show()


Path.cwd()



